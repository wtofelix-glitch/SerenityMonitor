{
  "name": "serenity-visual-tests",
  "private": true,
  "description": "Serenity 看板确定性视觉回归 + SW 行为 + 刷新压力测试（R0 基线）",
  "scripts": {
    "test": "playwright test",
    "baseline": "playwright test --update-snapshots",
    "test:visual": "playwright test monitor.spec.js",
    "test:sw": "playwright test --project=chromium-sw",
    "test:soak": "playwright test --project=chromium-soak"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
